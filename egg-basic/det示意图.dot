digraph {
    layout = dot;
    splines = spline;
    rankdir = LR;
    ranksep = 0.5;
    nodesep = 0.3;
    bgcolor = "transparent";
    
    subgraph cluster_0
    {
    label = "after determinization";
    pencolor = "lightgray";
    edge [arrowsize = 0.7; fontname = "Georgia";];
    node [color = black; fontname = "Georgia";];
    "I" [label ="[(start, ϵ, 1)]";style=filled,fillcolor=gold, penwidth=2.5];

    "I"->"P" [label = "  i:α/v";];

    "P" [label = "[(p, ϵ, 1)]";];
    "Q₁₂" [label = "
	[(q₁, (y₁+y₂)/(y₁+y₂+y₃), (w₁+w₂)/(w₁+w₂+w₃)), 
    (q₂,           y₃/(y₁+y₂+y₃),             w₃/(w₁+w₂+w₃))]
					";shape = box;style=rounded;];
	"P" -> "Q₁₂" [label = "x : (y₁+y₂+y₃) / (w₁+w₂+w₃)";];
	

	"N1" [color = transparent; style=invis];
	"Q₁₂" -> "N1" [label = "e₁";];
	"Q₁₂" -> "N1" [label = "e₂";];
	"Q₁₂" -> "N1" [label = "e₃";];
	"N2" [color = transparent; style=invis];
	"Q₁₂" -> "N2" [label = "e₄";];
	"Q₁₂" -> "N2" [label = "e₅";];
    }

    subgraph cluster_1
    {
    label = "before determinization";
    pencolor = "lightgray";
    edge [arrowsize = 0.7; fontname = "Georgia";];
    node [color = black; fontname = "Georgia";];
    "i" [label ="start";style=filled,fillcolor=gold,shape=circle, penwidth=2.5];
    "i" -> "p" [label = "i:α/v";];

    "p" [label = "p";shape = circle;];
    "q₁" [label = "q₁";shape = circle];
	"q₂" [label = "q₂";shape = circle;];
	"p" -> "q₁" [label = "x:y₁/w₁";];
	"p" -> "q₁" [label = "x:y₂/w₂";];
    "p" -> "q₂" [label = "x:y₃/w₃";];

	"n1" [color = transparent; style=invis];
	"q₁" -> "n1" [label = "e₁";];
	"q₁" -> "n1" [label = "e₂";];
	"q₁" -> "n1" [label = "e₃";];
	"n2" [color = transparent; style=invis];
	"q₂" -> "n2" [label = "e₄";];
	"q₂" -> "n2" [label = "e₅";];
    }
}